# Database
DATABASE_URL=postgresql+psycopg://attention_agent:password@localhost:5444/knowledge_base

# LLM Configuration
# LLM_PROVIDER can be: openai, anthropic, ollama
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:latest

# Embeddings Configuration
# EMBEDDINGS_PROVIDER can be: openai, ollama, jina
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=embeddinggemma

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Jina API Key (for multimodal embeddings like jina-clip-v1)
JINA_API_KEY=your_jina_api_key_here

# Ollama Endpoint (if running locally, typically http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PUBLIC_KEY=

# ==========================================
# Phase 4: Data Connectors Configuration
# ==========================================

# Email IMAP Connector
IMAP_SERVER=imap.gmail.com
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_FOLDER=INBOX

# Local Git Connector
LOCAL_GIT_REPO_PATH=.

# ==========================================
# Phase 5: A2A Messaging Configuration
# ==========================================
REGISTRY_URL=http://localhost:8000/api/v1/registry
SENDER_ID=local-agent-001
